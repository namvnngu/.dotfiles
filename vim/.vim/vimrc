""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""
" AUTOCOMMANDS                                                                 "
""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""

augroup mkdir_on_edit
    autocmd!
    autocmd BufWritePre * call s:mkdir_on_edit(expand('<afile>:p:h'))

    function! s:mkdir_on_edit(dir)
      if a:dir =~ '^/'
            \ && !isdirectory(a:dir)
            \ && input("'" . a:dir . "' does not exist. Create? [y/N] ") =~? '^y\%[es]$'
        call mkdir(a:dir, 'p')
      endif
    endfunction
augroup END

augroup c_ft
    autocmd!
    autocmd FileType c setlocal tags=./tags,tags,~/.tags/c-system
    autocmd FileType c if executable('clang-format') | setlocal formatprg=clang-format | endif
    autocmd FileType c let b:dispatch = 'cc -std=c99 -o %:p:r % && %:p:r'
    autocmd FileType c let b:start    = 'cc -std=c99 -o %:p:r % && %:p:r'
augroup END

augroup cpp_ft
    autocmd!
    autocmd FileType cpp setlocal tags=./tags,tags,~/.tags/cpp-system
    autocmd FileType cpp if executable('clang-format') | setlocal formatprg=clang-format | endif
    autocmd FileType cpp let b:dispatch = 'c++ -std=c++23 -o %:p:r % && %:p:r'
    autocmd FileType cpp let b:start    = 'c++ -std=c++23 -o %:p:r % && %:p:r'
augroup END

augroup python_ft
    autocmd!
    autocmd FileType python if executable('ruff') | setlocal formatprg=ruff\ format\ - | endif
    autocmd FileType python let b:dispatch = 'python3 %'
    autocmd FileType python let b:start    = 'python3 %'
augroup END

augroup markdown_ft
    autocmd!
    autocmd FileType markdown let b:dispatch = "mdp '%'"
    autocmd FileType markdown let b:start    = "mdp '%'"
augroup END

