---
BasedOnStyle: Google

# Line breaking
ColumnLimit: 80
AllowShortFunctionsOnASingleLine: None

# Indentation
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Pointers
PointerAlignment: Right

# Includes
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*>$'
    Priority: 0
  - Regex: '^".*"$'
    Priority: 1
...
