#!/usr/bin/env bash

# Author: Nam Nguyen <nam.vnngu@gmail.com>
# Description: Generate C++ tags file on system header files
# License: MIT License
# Date Created: August 09, 2026
# Date Modified: August 09, 2026 

# HELP

if [[ "${1}" == *-h* ]]; then
    printf "Generate C++ tags file on system header files.

Usage: 
  ctags-cpp-system [compiler] [tags_file]

Arguments:
  compiler   C compiler (default: clang)
  tags_file  Path of tags file (default: ~/.tags/cpp-system)

Options: 
  -h, --help     Print usage information
"
    exit 0
fi

# MAIN

if ! command -v ctags >/dev/null 2>&1; then
    echo "Error: ctags not found" >&2
    exit 1
fi

compiler="${1:-clang}"
if ! command -v "${compiler}" >/dev/null 2>&1; then
    echo "Error: compiler not found: ${compiler}" >&2
    exit 1
fi

default_tags_dir="${HOME}/.tags"
default_tags_file="${default_tags_dir}/cpp-system"
tags_file="${2:-${default_tags_file}}"
tags_dir="${tags_file%/*}"

compiler_output="$("${compiler}" -v -E -x c /dev/null 2>&1)"
include_dirs=()
searching=false

while IFS= read -r line; do
    if [[ "${line}" == '#include <...> search starts here:' ]]; then
        searching=true
        continue
    fi

    if [[ "${line}" == 'End of search list.' ]]; then
        searching=false
        continue
    fi

    if [[ "${searching}" != true ]]; then
        continue
    fi

    # Remove leading whitespace:
    #   - `${line%%[![:space:]]*}` Remove the longest matching suffix from line,
    #   which is non-whitespace characters, and produce whitespaces.
    #   - `${line#"    "}`         Remove the shortest matching prefix from line,
    #   which is whitespaces produced above.
    directory="${line#"${line%%[![:space:]]*}"}"

    if [[ -d "${directory}" ]]; then
        include_dirs+=("${directory}")
    fi
done <<< "${compiler_output}"

echo "Found system include directories:"
printf '  %s\n' "${include_dirs[@]}"

echo "Generating tags ${tags_file} ..."

mkdir -p "${tags_dir}"
ctags \
    --languages=c,c++ \
    --fields=+iaS \
    --extras=+q \
    --recurse \
    -o "${tags_file}" \
    "${include_dirs[@]}"

echo "Done!"
