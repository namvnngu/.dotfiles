#!/usr/bin/env bash

# Author: Nam Nguyen <nam.vnngu@gmail.com>
# Description: Create a file given a template name
# License: MIT License
# Date Created: December 01, 2025
# Date Modified: August 10, 2026

me="$(basename "${0}")"
VERSION="0.2.1"
template_dir="${NAMTOOLS_DATA_DIR}"

# Exits with status 1 and messages.
#
# Usage: exit-1 [message ...]
#
# Arguments:
#   [message ...]  Error messages
exit-1() {
    {
        printf '%s: ' "${me}"
        printf '%s\n' "${@}"
    } 1>&2
    exit 1
}

# Prints the version.
#
# Usage: print-version
print-version() {
    printf '%s %s\n' "${me}" "${VERSION}"
}

# Prints the usage information.
#
# Usage: print-help
print-help() {
    cat <<HEREDOC
${me} - Create a file given a template name [version ${VERSION}]

Usage: 
  ${me} [options]
  ${me} <template_name> <file_path>

Arguments:
  template_name  Template name
  file_path      Path of a file created based on template_name

Options: 
  -h, --help     Print usage information
  -l, --list     List all available templates
  -v, --version  Print version
HEREDOC
}

# Lists all available templates.
#
# Usage: list-templates
list-templates() {
    find "${template_dir}" -maxdepth 1 -name "templ-*.txt" \
        | sed -e "s/^.*templ-//" -e "s/.txt$//"
}

main() {
    case "${1}" in
        --help | -h)
            print-help
            exit
            ;;
        --list | -l)
            list-templates
            exit
            ;;
        --version | -v)
            print-version
            exit
            ;;
    esac

    local template_name="${1}"
    local template_file="${template_dir}/templ-${template_name}.txt"
    local file_path="${2}"

    if [[ -z "${template_name}" ]]; then
        exit-1 "Missing template name"
    fi

    if [[ -z "${file_path}" ]]; then
        exit-1 "Missing path of a file created based on \"${template_name}\""
    fi

    if [[ ! -e "${template_file}" ]]; then
        exit-1 "${template_file}: No such template"
    fi

    mkdir -p "$(dirname "${file_path}")"
    cp "${template_file}" "${file_path}"
}

main "${@}"
